_user_id),\n    seller_nick = COALESCE(?, seller_nick),\n    detail_json = COALESCE(?, detail_json),\n    seller_fill_status = CASE WHEN ? IS NOT NULL AND ? != '' THEN 'filled' ELSE COALESCE(seller_fill_status, 'pending') END,\n    seller_fill_fail_reason = CASE WHEN ? IS NOT NULL AND ? != '' THEN NULL ELSE seller_fill_fail_reason END,\n    updated_at = CURRENT_TIMESTAMP\n    WHERE id = ?`).run(t.sellerUserId||null,t.sellerNick||null,t.detailJson||null,t.sellerUserId||null,t.sellerUserId||null,t.sellerUserId||null,t.sellerUserId||null,e)}function markListingMonitorSellerFillFailed(e,t){r.db.prepare(`UPDATE listing_monitor_items SET seller_fill_status = 'failed',\n    seller_fill_fail_reason = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?`).run(t||"卖家信息补全失败",e)}function getPendingDmItems(e=500){return r.db.prepare(`SELECT i.*, t.dm_content, t.dm_batch_size, t.order_account_ids\n    FROM listing_monitor_items i JOIN listing_monitor_tasks t ON t.id = i.monitor_task_id\n    WHERE t.enabled = 1 AND i.is_dm_sent = 0 AND i.is_ordered = 0 AND i.dm_attempts < 3\n      AND i.seller_user_id IS NOT NULL AND i.seller_user_id != ''\n      AND t.dm_content IS NOT NULL AND t.dm_content != ''\n    ORDER BY i.id LIMIT ?`).all(e)}function markListingMonitorDm(e,t,n,s,o){if(t){r.db.prepare(`UPDATE listing_monitor_items SET is_dm_sent = 1, dm_status = 'sent', dm_account_id = ?,\n      dm_chat_id = ?, dm_sent_at = CURRENT_TIMESTAMP, dm_fail_reason = NULL, updated_at = CURRENT_TIMESTAMP WHERE id = ?`).run(n||null,s||null,e)}else{r.db.prepare(`UPDATE listing_monitor_items SET dm_status = 'failed', dm_attempts = dm_attempts + 1,\n      dm_fail_reason = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?`).run(o||"私信失败",e)}}function getPendingOrderItems(e=500){return r.db.prepare(`SELECT i.*, t.order_account_ids, t.order_batch_size FROM listing_monitor_items i\n    JOIN listing_monitor_tasks t ON t.id = i.monitor_task_id\n    WHERE t.enabled = 1 AND i.is_ordered = 0 AND i.order_attempts < 3\n   