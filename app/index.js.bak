teSettingsTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS settings (\n      key TEXT PRIMARY KEY,\n      value TEXT NOT NULL,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);safeAddColumn("settings","system_user_id","INTEGER");try{const e=r.db.prepare("PRAGMA table_info(settings)").all();const t=e.some((e=>e.name==="system_user_id"));const n=e.filter((e=>e.pk>0)).length>1;if(t&&!n){a.info("检测到 settings 表需要重建以支持用户隔离（复合主键）");const e=r.db.prepare("SELECT key, value, updated_at, system_user_id FROM settings").all();r.db.exec("DROP TABLE IF EXISTS settings");r.db.exec(`\n        CREATE TABLE settings (\n          key TEXT NOT NULL,\n          system_user_id INTEGER,\n          value TEXT NOT NULL,\n          updated_at TEXT DEFAULT CURRENT_TIMESTAMP,\n          PRIMARY KEY (key, system_user_id)\n        )\n      `);const t=r.db.prepare("INSERT INTO settings (key, system_user_id, value, updated_at) VALUES (?, ?, ?, ?)");for(const n of e){t.run(n.key,n.system_user_id??null,n.value,n.updated_at)}a.info(`已迁移 ${e.length} 条设置记录到新表结构（支持用户隔离）`)}}catch(e){a.warn(`检查 settings 表结构时出错: ${e?.message}`)}}function createAiSettingsProfilesTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS ai_settings_profiles (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      system_user_id INTEGER NOT NULL,\n      name TEXT,\n      fingerprint TEXT NOT NULL,\n      settings_json TEXT NOT NULL,\n      last_used_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      UNIQUE (system_user_id, fingerprint)\n    )\n  `);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_ai_profiles_user_last_used\n    ON ai_settings_profiles(system_user_id, last_used_at DESC)`)}function createAutoSellTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS autosell_rules (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      name TEXT NOT NULL,\n      enabled INTEGER DEFAULT 1,\n      item_id TEXT,\n      account_id TEXT,\n      delivery_type TEXT NOT NULL,\n      delivery_content TEXT,\n      api_config TEXT,\n      trigger_on TEXT DEFAULT 'paid',\n      workflow_id INTEGER,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);safeAddColumn("autosell_rules","workflow_id","INTEGER");safeAddColumn("autosell_rules","delay_seconds","INTEGER DEFAULT 0");safeAddColumn("autosell_rules","delay_mode","TEXT DEFAULT 'fixed'");safeAddColumn("autosell_rules","smart_delay_seconds_per_char","REAL DEFAULT 2");safeAddColumn("autosell_rules","item_specification","TEXT");try{const e=r.db.prepare(`\n      UPDATE autosell_rules SET item_specification = NULL\n      WHERE item_specification = '' OR (item_specification IS NOT NULL AND TRIM(item_specification) = '')\n    `);const t=e.run();if(t.changes>0)a.info(`自动发货规则: 已将 ${t.changes} 条规则的空白规格统一为 NULL`)}catch(e){}safeAddColumn("autosell_rules","system_user_id","INTEGER");safeAddColumn("autosell_rules","delivery_image_url","TEXT");safeAddColumn("autosell_rules","delivery_content_ids","TEXT");safeAddColumn("autosell_rules","delivery_content_id","INTEGER");safeAddColumn("autosell_rules","stock_content_ids","TEXT");safeAddColumn("autosell_rules","api_content_ids","TEXT");safeAddColumn("autosell_rules","keyword_match_prompt_message","TEXT");safeAddColumn("autosell_rules","notify_node_message","TEXT");r.db.exec(`\n    CREATE TABLE IF NOT EXISTS autosell_stock (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      rule_id INTEGER NOT NULL,\n      content TEXT NOT NULL,\n      used INTEGER DEFAULT 0,\n      used_order_id TEXT,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      used_at TEXT,\n      FOREIGN KEY (rule_id) REFERENCES autosell_rules(id) ON DELETE CASCADE\n    )\n  `);r.db.exec(`\n    CREATE TABLE IF NOT EXISTS autosell_logs (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      rule_id INTEGER,\n      order_id TEXT NOT NULL,\n      account_id TEXT NOT NULL,\n      delivery_type TEXT NOT NULL,\n      content TEXT NOT NULL,\n      status TEXT DEFAULT 'success',\n      error_message TEXT,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_autosell_stock_rule \n    ON autosell_stock(rule_id, used)`);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_autosell_logs_order \n    ON autosell_logs(order_id)`)}function createWorkflowTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS workflows (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      name TEXT NOT NULL,\n      description TEXT,\n      definition TEXT NOT NULL,\n      is_default INTEGER DEFAULT 0,\n      enabled INTEGER DEFAULT 1,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);safeAddColumn("workflows","system_user_id","INTEGER");r.db.exec(`\n    CREATE TABLE IF NOT EXISTS workflow_executions (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      workflow_id INTEGER NOT NULL,\n      order_id TEXT NOT NULL,\n      account_id TEXT NOT NULL,\n      rule_id INTEGER NOT NULL,\n      status TEXT DEFAULT 'pending',\n      current_node_id TEXT,\n      waiting_for_reply INTEGER DEFAULT 0,\n      expected_keywords TEXT,\n      context TEXT DEFAULT '{}',\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      FOREIGN KEY (workflow_id) REFERENCES workflows(id) ON DELETE CASCADE\n    )\n  `);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_workflow_exec_order \n    ON workflow_executions(order_id)`);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_workflow_exec_waiting \n    ON workflow_executions(account_id, waiting_for_reply, status)`);const e=r.db.prepare("SELECT id, system_user_id FROM workflows WHERE is_default = 1").all();if(e.length>1){const t=new Map;for(const n of e){const e=n.system_user_id??"null";const r=t.get(e);if(r===void 0||n.id<r)t.set(e,n.id)}const n=[...t.values()];const s=n.map((()=>"?")).join(",");r.db.prepare(`UPDATE workflows SET is_default = 0 WHERE is_default = 1 AND id NOT IN (${s})`).run(...n);a.info(`检测到多个默认流程，已按用户清理，保留: ${n.join(",")}`)}safeAddColumn("workflow_executions","system_user_id","INTEGER")}function createNotificationTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS notification_channels (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      type TEXT NOT NULL,\n      name TEXT NOT NULL,\n      config TEXT NOT NULL,\n      enabled INTEGER DEFAULT 1,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);safeAddColumn("notification_channels","account_id","TEXT");safeAddColumn("notification_channels","system_user_id","INTEGER");r.db.exec(`\n    CREATE TABLE IF NOT EXISTS message_notifications (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      account_id TEXT NOT NULL,\n      channel_id INTEGER NOT NULL,\n      keywords TEXT NOT NULL,\n      enabled INTEGER DEFAULT 1,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      FOREIGN KEY (channel_id) REFERENCES notification_channels(id) ON DELETE CASCADE\n    )\n  `);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_message_notifications_account \n    ON message_notifications(account_id)`);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_message_notifications_channel \n    ON message_notifications(channel_id)`);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_message_notifications_enabled \n    ON message_notifications(enabled)`)}function createSliderStatsTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS slider_stats (\n      system_user_id INTEGER,\n      account_id TEXT,\n      success_count INTEGER DEFAULT 0,\n      fail_count INTEGER DEFAULT 0,\n      last_success_at TEXT,\n      last_fail_at TEXT,\n      PRIMARY KEY (system_user_id, account_id)\n    )\n  `);r.db.exec("CREATE INDEX IF NOT EXISTS idx_slider_stats_user_account ON slider_stats(system_user_id, account_id)")}function createSystemUserTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS system_users (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      username TEXT NOT NULL UNIQUE,\n      email TEXT,\n      password_hash TEXT NOT NULL,\n      role TEXT DEFAULT 'user',\n      enabled INTEGER DEFAULT 1,\n      theme_mode TEXT DEFAULT 'dark',\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);safeAddColumn("system_users","theme_mode","TEXT DEFAULT 'dark'");r.db.exec(`CREATE INDEX IF NOT EXISTS idx_system_users_username \n    ON system_users(username)`);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_system_users_email \n    ON system_users(email)`);const e=r.db.prepare("SELECT COUNT(*) as count FROM system_users WHERE username = ?");const t=e.get("admin").count>0;if(!t){try{const e=(0,i.randomBytes)(16).toString("hex");const t=(0,i.pbkdf2Sync)("admin123",e,1e4,64,"sha512").toString("hex");const n=`${e}:${t}`;const s=r.db.prepare(`\n        INSERT INTO system_users (username, email, password_hash, role, enabled)\n        VALUES (?, ?, ?, ?, ?)\n      `);s.run("admin","admin@localhost",n,"admin",1);a.info("已创建默认管理员账号: admin / admin123")}catch(e){a.warn("创建默认管理员账号失败: "+(e?.message||String(e)))}}ensureDefaultWorkflowPerUser()}function ensureDefaultWorkflowPerUser(){try{const e=r.db.prepare("SELECT id FROM system_users").all();const t=JSON.stringify({nodes:[{id:"trigger",type:"trigger",name:"触发",config:{},posX:100,posY:200},{id:"delivery",type:"delivery",name:"发货",config:{},posX:350,posY:200},{id:"ship",type:"ship",name:"标记发货",config:{},posX:600,posY:200}],connections:[{fromNode:"trigger",fromOutput:"output_1",toNode:"delivery",toInput:"input_1"},{fromNode:"delivery",fromOutput:"output_1",toNode:"ship",toInput:"input_1"}]});const n=r.db.prepare("SELECT 1 FROM workflows WHERE system_user_id = ? LIMIT 1");const s=r.db.prepare("SELECT 1 FROM workflows WHERE system_user_id = ? AND name = ? LIMIT 1");const i=r.db.prepare(`\n      INSERT INTO workflows (name, description, definition, is_default, enabled, system_user_id)\n      VALUES (?, ?, ?, 1, 1, ?)\n    `);const c=r.db.prepare(`\n      INSERT INTO workflows (name, description, definition, is_default, enabled, system_user_id)\n      VALUES (?, ?, ?, 0, 1, ?)\n    `);const l=r.db.prepare(`\n      UPDATE workflows\n      SET description = ?, definition = ?\n      WHERE system_user_id = ? AND name = '免拼发货流程'\n    `);const u=JSON.stringify(o.nD);const d=JSON.stringify(o.J0);const f=JSON.stringify(o.mN);for(const r of e){if(!n.get(r.id)){i.run("默认流程","触发 → 发货 → 标记发货",t,r.id);a.info(`已为用户 ${r.id} 创建默认发货流程`)}if(!s.get(r.id,"关键词发货流程")){c.run("关键词发货流程","订单触发 → 关键词(精确匹配) → 发货 → 标记发货(虚拟)",u,r.id);a.info(`已为用户 ${r.id} 创建内置流程：关键词发货流程`)}if(!s.get(r.id,"确认收货发货流程")){c.run("确认收货发货流程","订单触发 → 标记发货(虚拟) → 通知 → 等待订单完成 → 发货",d,r.id);a.info(`已为用户 ${r.id} 创建内置流程：确认收货发货流程`)}if(!s.get(r.id,"免拼发货流程")){c.run("免拼发货流程","订单触发 → 发货 → [标记发货(虚拟) | 标记发货(免拼) → 标记发货(虚拟)]",f,r.id);a.info(`已为用户 ${r.id} 创建内置流程：免拼发货流程`)}else{l.run("订单触发 → 发货 → [标记发货(虚拟) | 标记发货(免拼) → 标记发货(虚拟)]",f,r.id);a.info(`已为用户 ${r.id} 更新内置流程：免拼发货流程 为最新定义`)}}}catch(e){a.warn("ensureDefaultWorkflowPerUser 失败: "+(e?.message||String(e)))}}function createSystemSettingsTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS system_settings (\n      key TEXT PRIMARY KEY,\n      value TEXT,\n      description TEXT,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);safeAddColumn("system_settings","system_user_id","INTEGER");try{const e=r.db.prepare("PRAGMA table_info(system_settings)").all();const t=e.some((e=>e.name==="system_user_id"));const n=e.filter((e=>e.pk>0)).length>1;if(t&&!n){a.info("检测到 system_settings 表需要重建以支持用户隔离（复合主键）");const e=r.db.prepare("SELECT key, value, description, updated_at, system_user_id FROM system_settings").all();r.db.exec("DROP TABLE IF EXISTS system_settings");r.db.exec(`\n        CREATE TABLE system_settings (\n          key TEXT NOT NULL,\n          system_user_id INTEGER,\n          value TEXT,\n          description TEXT,\n          updated_at TEXT DEFAULT CURRENT_TIMESTAMP,\n          PRIMARY KEY (key, system_user_id)\n        )\n      `);const t=r.db.prepare("INSERT INTO system_settings (key, system_user_id, value, description, updated_at) VALUES (?, ?, ?, ?, ?)");for(const n of e){t.run(n.key,n.system_user_id??null,n.value,n.description,n.updated_at)}a.info(`已迁移 ${e.length} 条系统设置记录到新表结构（支持用户隔离）`)}}catch(e){a.warn(`检查 system_settings 表结构时出错: ${e?.message}`)}const e=[{key:"allow_registration",value:"0",description:"允许用户注册"},{key:"show_default_login_info",value:"1",description:"显示默认登录信息"},{key:"login_slide_captcha",value:"0",description:"登录滑动验证码"},{key:"captcha_mode",value:"local",description:"滑块处理模式: local|manual|third_party|local_then_manual|local_then_third_party"},{key:"captcha_third_party_provider",value:"2captcha",description:"第三方滑块平台: 2captcha|capsolver"},{key:"captcha_third_party_api_key",value:"",description:"第三方滑块 API Key"},{key:"captcha_manual_verify_base_url",value:"",description:"人工模式验证链接基础 URL"},{key:"smtp_host",value:"",description:"SMTP服务器地址"},{key:"smtp_port",value:"465",description:"SMTP端口"},{key:"smtp_user",value:"",description:"SMTP用户名"},{key:"smtp_password",value:"",description:"SMTP密码"},{key:"smtp_from_email",value:"",description:"发件邮箱"},{key:"smtp_from_name",value:"",description:"发件人显示名"},{key:"item_detail_auto_fetch",value:"1",description:"自动获取商品详情文字介绍供AI使用(1=启用,0=禁用)"},{key:"autoreply_opt_out_on_manual_reply",value:"1",description:"人工介入时是否暂停该会话所有自动回复(1=是,0=否)"},{key:"autoreply_disable_after_paid",value:"0",description:"买家付款后是否停止该会话自动回复(1=是,0=否)；依据本地订单状态"},{key:"autoreply_manual_pause_minutes",value:"30",description:"人工介入时暂停自动回复的分钟数（1-1440，默认30）"},{key:"msg_merge_enabled",value:"0",description:"多消息合并：防止用户分段发送导致AI回复混乱(1=启用,0=禁用)"},{key:"msg_merge_wait_seconds",value:"3",description:"多消息合并等待时长（秒，0.5-30，默认3）"},{key:"msg_merge_threshold_chars",value:"5",description:"多消息合并短消息字符阈值（2-50，默认5）"},{key:"account_status_notify_enabled",value:"0",description:"账号状态变化是否触发通知(1=开启,0=关闭)"},{key:"login_recovery_after_im",value:"password",description:"IM刷新失败后恢复:password=自动账密登录,notify=仅发通知(需通知开启且渠道)"},{key:"login_recovery_notify_fallback_password",value:"0",description:"仅通知模式下通知不可用时是否回退账密:1=回退,0=不回退(默认)"},{key:"login_recovery_fail_cooldown_minutes",value:"20",description:"登录态恢复链整轮失败后冷却分钟数(0=关闭,默认20,最大10080)"},{key:"conversation_page_enabled",value:"1",description:"对话消息页面是否启用(1=启用,0=关闭时仅后端收消息供其它功能用)，默认开启"},{key:"session_keep_api_refresh_enabled",value:"1",description:"API 定时刷新总开关(1=开启,0=关闭)，默认开启"},{key:"session_keep_strategy",value:"api_frequent",description:"会话保持方式: api_only=API刷新,api_plus_weak_verify=API刷新+变弱验证,api_frequent=自定义API刷新,api_frequent_plus_weak_verify=自定义API刷新+变弱验证"},{key:"session_keep_api_interval_minutes",value:"1",description:"API 刷新时间最小值（分钟）"},{key:"session_keep_api_interval_max_minutes",value:"3",description:"API 刷新时间最大值（分钟）"},{key:"goods_selector_source",value:"list",description:"自动发货/自动回复页面商品选择使用的库存：card=卡片式(20)，list=列表式(100)"},{key:"goods_selector_refresh_mode",value:"cache",description:"选择商品点击刷新时：cache=请求后端缓存，xianyu=从闲鱼拉取"},{key:"cleanup_schedule",value:"monthly_1",description:"定时清理执行频率：monthly_1=每月1号,weekly_0=每周日,daily=每天,interval=每N天,off=关闭"},{key:"cleanup_interval_hours",value:"1",description:"定时清理间隔（天），仅当 cleanup_schedule=interval 时有效"},{key:"cleanup_retention_conversations_days",value:"30",description:"对话及消息保留天数"},{key:"cleanup_retention_orders_days",value:"365",description:"订单保留天数"},{key:"cleanup_retention_order_reviews_days",value:"365",description:"订单评价保留天数"},{key:"cleanup_retention_user_avatars_days",value:"90",description:"用户头像缓存保留天数（未更新）"},{key:"cleanup_retention_workflow_exec_days",value:"90",description:"工作流执行记录保留天数（仅已结束）"},{key:"cleanup_retention_autosell_logs_days",value:"90",description:"自动售卖日志保留天数"},{key:"cleanup_prompts_offsale",value:"1",description:"是否按商品快照清理已下架商品的AI提示词(1=是,0=否)"}];const t=r.db.prepare(`\n    INSERT OR IGNORE INTO system_settings (key, system_user_id, value, description)\n    VALUES (?, NULL, ?, ?)\n  `);for(const n of e){t.run(n.key,n.value,n.description)}const n=[{key:"allow_registration",value:"0"},{key:"show_default_login_info",value:"1"},{key:"login_slide_captcha",value:"0"}];const s=r.db.prepare(`\n    UPDATE system_settings \n    SET value = ?, updated_at = CURRENT_TIMESTAMP\n    WHERE key = ? AND system_user_id IS NULL AND (value IS NULL OR value = '')\n  `);for(const{key:e,value:t}of n){const n=s.run(t,e);if(n.changes>0){a.info(`已将设置 ${e} 更新为默认值 '${t}'`)}}}function createScheduledTasksTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS scheduled_tasks (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      name TEXT NOT NULL,\n      task_type TEXT NOT NULL,\n      account_id TEXT,\n      enabled INTEGER DEFAULT 1,\n      interval_hours INTEGER DEFAULT 24,\n      delay_minutes INTEGER DEFAULT 0,\n      random_delay_max INTEGER DEFAULT 0,\n      last_run_at TEXT,\n      next_run_at TEXT,\n      run_count INTEGER DEFAULT 0,\n      system_user_id INTEGER,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_scheduled_tasks_account \n    ON scheduled_tasks(account_id)`);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_scheduled_tasks_user \n    ON scheduled_tasks(system_user_id)`);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_scheduled_tasks_enabled \n    ON scheduled_tasks(enabled, next_run_at)`);safeAddColumn("scheduled_tasks","random_delay_max","INTEGER DEFAULT 0")}function createListingMonitorTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS listing_monitor_tasks (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      system_user_id INTEGER NOT NULL,\n      monitor_type TEXT NOT NULL DEFAULT 'listing',\n      keyword TEXT NOT NULL,\n      price_min REAL,\n      price_max REAL,\n      publish_days INTEGER,\n      interval_minutes INTEGER NOT NULL DEFAULT 5,\n      collect_pages INTEGER NOT NULL DEFAULT 1,\n      account_ids TEXT NOT NULL DEFAULT '[]',\n      order_account_ids TEXT NOT NULL DEFAULT '[]',\n      dm_content TEXT,\n      dm_batch_size INTEGER NOT NULL DEFAULT 5,\n      order_batch_size INTEGER NOT NULL DEFAULT 5,\n      direct_order INTEGER NOT NULL DEFAULT 0,\n      enabled INTEGER NOT NULL DEFAULT 1,\n      last_run_at TEXT,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    );\n    CREATE INDEX IF NOT EXISTS idx_lmt_user_enabled\n      ON listing_monitor_tasks(system_user_id, enabled);\n\n    CREATE TABLE IF NOT EXISTS listing_monitor_items (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      monitor_task_id INTEGER NOT NULL,\n      system_user_id INTEGER NOT NULL,\n      item_id TEXT NOT NULL,\n      title TEXT,\n      price TEXT,\n      area TEXT,\n      pic_url TEXT,\n      seller_id TEXT,\n      seller_user_id TEXT,\n      seller_nick TEXT,\n      seller_avatar TEXT,\n      want_count TEXT,\n      tags TEXT,\n      publish_time TEXT,\n      target_url TEXT,\n      raw_json TEXT,\n      first_seen_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      last_seen_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      is_dm_sent INTEGER NOT NULL DEFAULT 0,\n      dm_account_id TEXT,\n      dm_chat_id TEXT,\n      dm_status TEXT,\n      dm_sent_at TEXT,\n      dm_attempts INTEGER NOT NULL DEFAULT 0,\n      dm_fail_reason TEXT,\n      is_ordered INTEGER NOT NULL DEFAULT 0,\n      order_account_id TEXT,\n      order_id TEXT,\n      order_status TEXT,\n      order_attempts INTEGER NOT NULL DEFAULT 0,\n      order_fail_reason TEXT,\n      ordered_at TEXT,\n      material_id INTEGER,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      UNIQUE(monitor_task_id, item_id)\n    );\n    CREATE INDEX IF NOT EXISTS idx_lmi_user_created\n      ON listing_monitor_items(system_user_id, id DESC);\n    CREATE INDEX IF NOT EXISTS idx_lmi_pending_dm\n      ON listing_monitor_items(is_dm_sent, is_ordered, dm_attempts);\n    CREATE INDEX IF NOT EXISTS idx_lmi_pending_order\n      ON listing_monitor_items(is_ordered, order_attempts);\n\n    CREATE TABLE IF NOT EXISTS listing_monitor_logs (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      monitor_task_id INTEGER NOT NULL,\n      system_user_id INTEGER NOT NULL,\n      monitor_type TEXT,\n      keyword TEXT,\n      account_id TEXT,\n      used_account_ids TEXT NOT NULL DEFAULT '[]',\n      pages_collected INTEGER NOT NULL DEFAULT 0,\n      fetched_count INTEGER NOT NULL DEFAULT 0,\n      inserted_count INTEGER NOT NULL DEFAULT 0,\n      updated_count INTEGER NOT NULL DEFAULT 0,\n      status TEXT NOT NULL,\n      trigger_type TEXT NOT NULL DEFAULT 'auto',\n      message TEXT,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP\n    );\n    CREATE INDEX IF NOT EXISTS idx_lml_user_created\n      ON listing_monitor_logs(system_user_id, id DESC);\n    CREATE INDEX IF NOT EXISTS idx_lml_task_created\n      ON listing_monitor_logs(monitor_task_id, id DESC);\n\n    CREATE TABLE IF NOT EXISTS order_fallback_accounts (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      system_user_id INTEGER NOT NULL UNIQUE,\n      account_ids TEXT NOT NULL DEFAULT '[]',\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    );\n    CREATE UNIQUE INDEX IF NOT EXISTS idx_ofa_user\n      ON order_fallback_accounts(system_user_id);\n  `);safeAddColumn("listing_monitor_items","material_id","INTEGER");safeAddColumn("listing_monitor_items","dm_sent_at","TEXT");safeAddColumn("listing_monitor_items","detail_json","TEXT");safeAddColumn("listing_monitor_items","seller_fill_status","TEXT");safeAddColumn("listing_monitor_items","seller_fill_fail_reason","TEXT");safeAddColumn("listing_monitor_logs","used_account_ids","TEXT NOT NULL DEFAULT '[]'")}function createProductPublishTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS product_publish_materials (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      system_user_id INTEGER NOT NULL,\n      title TEXT NOT NULL,\n      description TEXT NOT NULL,\n      price REAL NOT NULL,\n      original_price REAL,\n      category TEXT,\n      category_attributes TEXT NOT NULL DEFAULT '{}',\n      images TEXT NOT NULL DEFAULT '[]',\n      delivery_method TEXT NOT NULL DEFAULT 'express',\n      postage REAL NOT NULL DEFAULT 0,\n      address TEXT,\n      brand TEXT,\n      condition TEXT NOT NULL DEFAULT '全新',\n      remark TEXT,\n      specifications TEXT NOT NULL DEFAULT '[]',\n      variants TEXT NOT NULL DEFAULT '[]',\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    );\n    CREATE INDEX IF NOT EXISTS idx_ppm_user_created\n      ON product_publish_materials(system_user_id, created_at DESC);\n\n    CREATE TABLE IF NOT EXISTS product_publish_addresses (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      system_user_id INTEGER,\n      address TEXT NOT NULL,\n      account_id TEXT,\n      is_enabled INTEGER NOT NULL DEFAULT 1,\n      use_count INTEGER NOT NULL DEFAULT 0,\n      last_used_at TEXT,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    );\n    CREATE UNIQUE INDEX IF NOT EXISTS idx_ppa_unique_scope\n      ON product_publish_addresses(IFNULL(system_user_id, -1), IFNULL(account_id, ''), address);\n    CREATE INDEX IF NOT EXISTS idx_ppa_enabled_account\n      ON product_publish_addresses(is_enabled, account_id);\n\n    CREATE TABLE IF NOT EXISTS product_publish_logs (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      system_user_id INTEGER NOT NULL,\n      account_id TEXT NOT NULL,\n      title TEXT NOT NULL,\n      description TEXT,\n      price TEXT,\n      material_id INTEGER,\n      batch_id TEXT,\n      status TEXT NOT NULL DEFAULT 'pending',\n      item_url TEXT,\n      item_id TEXT,\n      error_message TEXT,\n      resolved_address_id INTEGER,\n      resolved_address_text TEXT,\n      address_source TEXT,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    );\n    CREATE INDEX IF NOT EXISTS idx_ppl_user_created\n      ON product_publish_logs(system_user_id, created_at DESC);\n    CREATE INDEX IF NOT EXISTS idx_ppl_batch_status\n      ON product_publish_logs(batch_id, status);\n\n    CREATE TABLE IF NOT EXISTS product_publish_meta (\n      key TEXT PRIMARY KEY,\n      value TEXT NOT NULL\n    );\n  `);safeAddColumn("product_publish_materials","specifications","TEXT NOT NULL DEFAULT '[]'");safeAddColumn("product_publish_materials","variants","TEXT NOT NULL DEFAULT '[]'");safeAddColumn("product_publish_materials","category_attributes","TEXT NOT NULL DEFAULT '{}'");const e=[["北京市",["朝阳区","海淀区","丰台区","通州区","大兴区"]],["天津市",["和平区","河西区","南开区","西青区","滨海新区"]],["河北省",["石家庄市长安区","唐山市路北区","保定市莲池区","廊坊市广阳区","沧州市运河区"]],["山西省",["太原市小店区","大同市平城区","晋中市榆次区","运城市盐湖区","临汾市尧都区"]],["内蒙古自治区",["呼和浩特市赛罕区","包头市昆都仑区","鄂尔多斯市东胜区","赤峰市红山区","呼伦贝尔市海拉尔区"]],["辽宁省",["沈阳市和平区","大连市中山区","鞍山市铁东区","锦州市太和区","营口市站前区"]],["吉林省",["长春市南关区","吉林市船营区","四平市铁西区","延边州延吉市","通化市东昌区"]],["黑龙江省",["哈尔滨市南岗区","齐齐哈尔市龙沙区","牡丹江市东安区","大庆市萨尔图区","佳木斯市向阳区"]],["上海市",["浦东新区","闵行区","徐汇区","宝山区","松江区"]],["江苏省",["南京市建邺区","苏州市工业园区","无锡市滨湖区","徐州市云龙区","南通市崇川区"]],["浙江省",["杭州市西湖区","宁波市鄞州区","温州市鹿城区","嘉兴市南湖区","金华市义乌市"]],["安徽省",["合肥市蜀山区","芜湖市镜湖区","蚌埠市蚌山区","阜阳市颍州区","安庆市迎江区"]],["福建省",["福州市鼓楼区","厦门市思明区","泉州市丰泽区","漳州市芗城区","莆田市城厢区"]],["江西省",["南昌市红谷滩区","赣州市章贡区","九江市濂溪区","上饶市信州区","宜春市袁州区"]],["山东省",["济南市历下区","青岛市市南区","烟台市芝罘区","潍坊市奎文区","临沂市兰山区"]],["河南省",["郑州市金水区","洛阳市洛龙区","南阳市宛城区","新乡市红旗区","商丘市睢阳区"]],["湖北省",["武汉市武昌区","宜昌市西陵区","襄阳市樊城区","荆州市沙市区","黄石市黄石港区"]],["湖南省",["长沙市岳麓区","株洲市天元区","湘潭市岳塘区","岳阳市岳阳楼区","常德市武陵区"]],["广东省",["广州市天河区","深圳市南山区","佛山市南海区","东莞市南城街道","珠海市香洲区"]],["广西壮族自治区",["南宁市青秀区","柳州市城中区","桂林市秀峰区","北海市海城区","玉林市玉州区"]],["海南省",["海口市龙华区","三亚市吉阳区","儋州市那大镇","琼海市嘉积镇","文昌市文城镇"]],["重庆市",["渝中区","江北区","南岸区","渝北区","九龙坡区"]],["四川省",["成都市武侯区","绵阳市涪城区","德阳市旌阳区","乐山市市中区","南充市顺庆区"]],["贵州省",["贵阳市观山湖区","遵义市汇川区","六盘水市钟山区","毕节市七星关区","安顺市西秀区"]],["云南省",["昆明市五华区","曲靖市麒麟区","玉溪市红塔区","大理州大理市","西双版纳州景洪市"]