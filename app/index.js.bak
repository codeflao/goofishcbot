ify_base_url",""],["captcha_local_fail_threshold","5"],["token_captcha_headless","0"],["token_captcha_manual_drag","0"],["slider_captcha_method","reference_stealth"],["password_login_slider_method","reference"],["slider_max_concurrent","3"],["slider_wait_timeout","60"],["slider_viewport_mode","large"],["slider_large_viewport_keys","1920x1080,2560x1440,3440x1440"],["slider_default_viewport_keys","1920x1080,2560x1440,3440x1440,1920x1200,1680x1050,1600x900"],["login_recovery_after_im","notify"],["login_recovery_notify_fallback_password","0"],["login_recovery_fail_cooldown_minutes","20"],["session_keep_strategy","api_frequent"],["session_keep_browser_im_refresh","1"],["session_rebuild_on_cookie_token_change","0"],["session_rebuild_after_browser_im_refresh","1"],["session_rebuild_on_human_browse_cookie_change","0"],["session_rebuild_after_human_browse","0"],["session_keep_browser_im_interval_minutes","12"],["session_keep_browser_im_interval_max_minutes","18"],["session_keep_api_refresh_enabled","1"],["session_keep_api_interval_minutes","1"],["session_keep_api_interval_max_minutes","3"],["token_refresh_enabled","1"],["token_refresh_reconnect_after_success","1"],["token_refresh_interval_minutes","50"],["token_refresh_interval_max_minutes","60"],["im_refresh_verify_fail_reconnect","0"],["im_refresh_verify_fail_action","none"],["im_refresh_verify_fail_rollback_target","no_rollback"],["session_keep_human_browse_enabled","0"],["session_keep_human_browse_headless","1"],["session_keep_human_browse_interval_minutes","40"],["session_keep_human_browse_interval_max_minutes","60"],["session_keep_human_browse_schedule_mode","per_account"],["scheduled_soft_restart_enabled","0"],["scheduled_soft_restart_interval_hours","8"]];function ensureCaptchaAndConnectionSettingsDefaults(){try{const e=db.prepare("SELECT DISTINCT system_user_id FROM system_settings").all();const t=[null];for(const n of e){if(n.system_user_id!=null&&!t.includes(n.system_user_id))t.push(n.system_user_id)}const n=db.prepare(`\n      INSERT OR IGNORE INTO system_settings (key, system_user_id, value, description, updated_at)\n      VALUES (?, NULL, ?, NULL, CURRENT_TIMESTAMP)\n    `);const r=db.prepare(`\n      INSERT OR IGNORE INTO system_settings (key, system_user_id, value, description, updated_at)\n      VALUES (?, ?, ?, NULL, CURRENT_TIMESTAMP)\n    `);const s=db.prepare(`\n      UPDATE system_settings\n      SET value = ?, updated_at = CURRENT_TIMESTAMP\n      WHERE key = ? AND system_user_id IS NULL AND (value IS NULL OR value = '')\n    `);const o=db.prepare(`\n      UPDATE system_settings\n      SET value = ?, updated_at = CURRENT_TIMESTAMP\n      WHERE key = ? AND system_user_id = ? AND (value IS NULL OR value = '')\n    `);for(const[e,i]of c){for(const a of t){if(a===null||a===void 0){const t=s.run(i,e);if(t.changes===0)n.run(e,i)}else{const t=o.run(i,e,a);if(t.changes===0)r.run(e,a,i)}}}}catch(e){a.warn(`[迁移] 补齐验证码与连接默认值失败: ${e?.message}`)}}function createItemAutoUpshelfTable(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS item_auto_upshelf (\n      account_id TEXT NOT NULL,\n      item_id TEXT NOT NULL,\n      enabled INTEGER NOT NULL DEFAULT 1,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      PRIMARY KEY (account_id, item_id)\n    )\n  `);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_item_auto_upshelf_account ON item_auto_upshelf(account_id)`)}function createReplyContentLibraryTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS reply_content_library (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      type TEXT NOT NULL,\n      content TEXT NOT NULL,\n      account_ids TEXT,\n      enabled INTEGER DEFAULT 1,\n      sort_order INTEGER DEFAULT 0,\n      system_user_id INTEGER,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_reply_content_library_type ON reply_content_library(type)`);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_reply_content_library_system_user ON reply_content_library(system_user_id)`);safeAddColumn("reply_content_library","name","TEXT DEFAULT ''");safeAddColumn("reply_content_library","description","TEXT");safeAddColumn("reply_content_library","folder_id","INTEGER");r.db.exec(`\n    CREATE TABLE IF NOT EXISTS reply_content_folder (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      type TEXT NOT NULL,\n      name TEXT NOT NULL,\n      sort_order INTEGER DEFAULT 0,\n      system_user_id INTEGER,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);r.db.exec("CREATE INDEX IF NOT EXISTS idx_reply_content_folder_type_user ON reply_content_folder(type, system_user_id)")}function createDeliveryContentLibraryTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS delivery_content_library (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      type TEXT NOT NULL,\n      name TEXT DEFAULT '',\n      content TEXT NOT NULL DEFAULT '',\n      image_url TEXT,\n      description TEXT,\n      account_ids TEXT,\n      enabled INTEGER DEFAULT 1,\n      sort_order INTEGER DEFAULT 0,\n      system_user_id INTEGER,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_delivery_content_library_type ON delivery_content_library(type)`);r.db.exec(`CREATE INDEX IF NOT EXISTS idx_delivery_content_library_system_user ON delivery_content_library(system_user_id)`);safeAddColumn("delivery_content_library","api_config","TEXT");safeAddColumn("delivery_content_library","item_specification","TEXT");safeAddColumn("delivery_content_library","keywords","TEXT");safeAddColumn("delivery_content_library","folder_id","INTEGER");r.db.exec(`\n    CREATE TABLE IF NOT EXISTS delivery_content_folder (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      type TEXT NOT NULL,\n      name TEXT NOT NULL,\n      sort_order INTEGER DEFAULT 0,\n      system_user_id INTEGER,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);r.db.exec("CREATE INDEX IF NOT EXISTS idx_delivery_content_folder_type_user ON delivery_content_folder(type, system_user_id)")}function createConversationQuickReplyTables(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS conversation_quick_reply_folder (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      name TEXT NOT NULL DEFAULT '',\n      sort_order INTEGER DEFAULT 0,\n      system_user_id INTEGER,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n    )\n  `);r.db.exec("CREATE INDEX IF NOT EXISTS idx_conversation_quick_reply_folder_user ON conversation_quick_reply_folder(system_user_id)");r.db.exec(`\n    CREATE TABLE IF NOT EXISTS conversation_quick_reply_item (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      folder_id INTEGER,\n      name TEXT NOT NULL DEFAULT '',\n      content TEXT NOT NULL DEFAULT '',\n      enabled INTEGER DEFAULT 1,\n      sort_order INTEGER DEFAULT 0,\n      system_user_id INTEGER,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      FOREIGN KEY (folder_id) REFERENCES conversation_quick_reply_folder(id) ON DELETE SET NULL\n    )\n  `);r.db.exec("CREATE INDEX IF NOT EXISTS idx_conversation_quick_reply_item_user ON conversation_quick_reply_item(system_user_id)");r.db.exec("CREATE INDEX IF NOT EXISTS idx_conversation_quick_reply_item_folder ON conversation_quick_reply_item(folder_id)")}function createDeliveryContentStockTable(){r.db.exec(`\n    CREATE TABLE IF NOT EXISTS delivery_content_stock (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      delivery_content_id INTEGER NOT NULL,\n      content TEXT NOT NULL,\n      used INTEGER DEFAULT 0,\n      used_order_id TEXT,\n      used_at TEXT,\n      created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n      FOREIGN KEY (delivery_content_id) REFERENCES delivery_content_library(